# Application
APP_ENV=development
APP_PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=sabify
DB_PASSWORD=sabify_password
DB_NAME=sabify_db
DB_SSLMODE=disable

# AI Service
AI_SERVICE_URL=http://localhost:8082

# ---------------------------------------------------------------------------
# BMONI Embedded (paid course enrollment)
# Docs: https://bkey.mintlify.app  ·  Sandbox base: https://embedded-dev.bmoni.com
# ---------------------------------------------------------------------------

# Base URL (origin only — do NOT append /v1; paths already start with /v1/)
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# Partner API key, sent as `x-api-key` on every request.
# NOTE: the shared key printed in the BMONI docs (pk_a025...) works against the
# sandbox, but its user namespace is shared and both test personas may already
# be consumed. For a clean, withdrawal-capable wallet, email
# developers@bkey.me for your own sandbox key, then run the bootstrap tool
# with it BEFORE anyone else creates the persona user on that key.
BMONI_API_KEY=

# Webhook verification secret. When set, POST /webhooks/bmoni requires a valid
# HMAC-SHA256 signature (X-Webhook-Signature) over the raw body. Generate with:
#   openssl rand -hex 32
BMONI_WEBHOOK_SECRET=

# AES-256-GCM key that seals the wallet owner private key at rest
# (bmoni_wallets.owner_key_enc). REQUIRED for teacher withdrawals: without it
# the bootstrap tool cannot persist the owner key and payouts stay disabled.
# Generate with:
#   openssl rand -hex 32
# The key must be the SAME value that was set when tools/bmoni-bootstrap ran,
# or stored keys cannot be decrypted.
BMONI_WALLET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Platform wallet provisioning (one-time, from the repo root):
#
#   BMONI_API_KEY=... BMONI_WALLET_ENCRYPTION_KEY=... go run ./tools/bmoni-bootstrap
#   # sandbox personas: -persona bunch (Bunch Dillon, default) | -persona samson (Samson Jabo)
#
# Bunch Dillon: phone +2348000000000 · BVN 95888168924
# Samson Jabo:  phone +2348000000001 · BVN 22222222222
#
# The tool creates user -> smart wallet -> KYC -> NGN rail and stores the VBA.
# Re-running is idempotent; a 409 (user already exists) is recovered via
# GET /v1/smart-wallets/by-phone. A wallet whose owner key predates the
# encryption feature cannot sign withdrawals (no owner-rotation endpoint) —
# provision a fresh persona on a fresh/dedicated key to enable payouts.
# ---------------------------------------------------------------------------